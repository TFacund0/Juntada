{
  "name": "juntada",
  "version": "1.0.0",
  "private": true,
  "description": "Juntada — plataforma de juegos para jugar en grupo",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @juntada/backend dev",
    "dev:frontend": "pnpm --filter @juntada/frontend dev",
    "dev": "pnpm --parallel -r --if-present run dev",
    "build:frontend": "pnpm --filter @juntada/frontend build",
    "start": "pnpm --filter @juntada/backend start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "license": "UNLICENSED",
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "workbox-window": "^7.4.1"
  }
}
