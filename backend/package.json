{
  "name": "@juntada/backend",
  "version": "1.0.0",
  "description": "Servidor de Juntada (Express + WebSocket)",
  "main": "server.ts",
  "private": true,
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
