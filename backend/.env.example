# Port the HTTP/WS server listens on. Defaults to 3001 if unset.
PORT=3001

# development | production | test — defaults to development.
NODE_ENV=development

# Restricts CORS to this origin. Leave unset in dev and in prod as long as
# frontend and backend share the same origin (see render.yaml comment).
# Set it once a custom domain fronts the app.
# CORS_ORIGIN=https://your-domain.com

# Optional. Reports uncaught exceptions and WS handler errors to Sentry.
# Leave unset to disable error tracking entirely (default, safe for local dev).
# Get one from a free Sentry.io project (Node/Express platform).
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
