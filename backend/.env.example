# Port the HTTP/WS server listens on. Defaults to 3001 if unset.
PORT=3001

# development | production | test — defaults to development.
NODE_ENV=development

# Restricts CORS to this origin. Leave unset in dev and in prod as long as
# frontend and backend share the same origin (see render.yaml comment).
# Set it once a custom domain fronts the app.
# CORS_ORIGIN=https://your-domain.com

# Optional. Reports uncaught exceptions and WS handler errors to Sentry.
# Leave unset to disable error tracking entirely (default, safe for local dev).
# Get one from a free Sentry.io project (Node/Express platform).
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Optional. Periodically snapshots rooms/groups to Redis and restores them on
# boot, so a restart (deploy, Render free-tier sleep) doesn't wipe active
# games. Leave unset to disable persistence entirely (default, safe for
# local dev — everything stays in-memory-only like before).
# Get one from a free Redis database on upstash.com.
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Prefixes the Redis key used above — only matters if multiple deployments
# (e.g. staging and production) share the same Redis database, so their
# snapshots don't collide. Defaults to "juntada" if unset. Give each
# deployment sharing a database a distinct value.
# REDIS_NAMESPACE=juntada-production

# Postgres connection string for the account/auth data layer (see
# backend/src/db/). Supabase's "Connection pooling" string works here.
# Required in production for register/login/auth routes to work at all —
# see backend/src/db/client.ts for the lazy-throw behavior if unset.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# HS256 signing secrets for access + refresh JWTs (see backend/src/auth/).
# Required in production — generate with a random command like openssl rand -base64 32.
# JWT_ACCESS_SECRET=change-me
# JWT_REFRESH_SECRET=change-me-too

# Resend API key for transactional email (password reset). Optional for
# local dev — ships against Resend's shared test domain by default (only
# delivers to your own Resend account address until a custom domain is
# verified, see design doc).
# RESEND_API_KEY=re_xxxxxxxx

# "From" address for outgoing auth email. Defaults to Resend's shared
# test-domain sender if unset.
# MAIL_FROM=Juntada <onboarding@resend.dev>

# Base URL the frontend is served from — used to build the password-reset
# link embedded in the email. Defaults to http://localhost:5173 if unset.
# APP_URL=https://your-domain.com
