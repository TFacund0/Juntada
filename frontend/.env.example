# Backend port the dev WS client connects to (only used when running
# `pnpm dev`, since Vite and the backend run as separate servers locally).
# Defaults to 3001 if unset. Not used in production — there frontend and
# backend share the same origin.
VITE_BACKEND_PORT=3001

# Lifts the "maintenance" gate on games flagged `maintenance: true` in their
# GameDef (see games/maintenance.ts), so they're playable for testing. Leave
# unset in production. Set to "true" only in the staging deploy's own env
# vars (Render dashboard), never committed here.
# VITE_DISABLE_MAINTENANCE_GATE=true
